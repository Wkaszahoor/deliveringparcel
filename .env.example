sAPP_NAME=Deliveringparcel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dplive.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deliveringparcel
DB_USERNAME=root
DB_PASSWORD= 


BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=60

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=deliveringparcel.com
MAIL_PORT=465
MAIL_USERNAME=service@deliveringparcel.com
MAIL_PASSWORD=deliveringparcel
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=service@deliveringparcel.com
MAIL_FROM_NAME="Deliveringparcel"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# STRIPE PAYMENT GATEWAY (C2) — valueless placeholders on purpose.
# Real keys live ONLY in the local .env, which is never committed.
# Empty values = mock/sandbox mode (safe for local development).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# GOOGLE OAUTH (Sign in with Google) — get credentials from
# https://console.cloud.google.com/apis/credentials, add
# {APP_URL}/auth/google/callback as an authorized redirect URI.
# Empty values = the "Sign in with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# FACEBOOK OAUTH (Sign in with Facebook) — get credentials from
# https://developers.facebook.com/apps, add
# {APP_URL}/auth/facebook/callback as a valid OAuth redirect URI.
# Empty values = the "Sign in with Facebook" button is hidden.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# GOOGLE PLACES API (pull Google reviews into Tools > Testimonials) — free
# API key from https://console.cloud.google.com/apis/credentials with the
# "Places API" enabled, plus your business's Place ID (find it at
# https://developers.google.com/maps/documentation/places/web-service/place-id).
# Empty values = the "Sync from Google" button is hidden in the admin.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=



PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
